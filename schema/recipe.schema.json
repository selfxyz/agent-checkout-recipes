{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agenttools.xyz/schemas/checkout-recipe.schema.json",
  "title": "Checkout recipe",
  "description": "A machine-readable recipe for completing a checkout on an e-commerce platform or a specific merchant. Mirrors registry/src/types.ts (the source of truth).",
  "oneOf": [{ "$ref": "#/definitions/platform" }, { "$ref": "#/definitions/merchant" }],
  "definitions": {
    "status": {
      "description": "verified = a real purchase confirmed out-of-band (email receipt); partial = card fill proven but no receipt-verified purchase; unverified = derived from platform structure; dead-end = cannot be completed unattended.",
      "enum": ["verified", "partial", "unverified", "dead-end"]
    },
    "cardSurface": {
      "enum": [
        "stripe-payment-element",
        "stripe-split",
        "shopify-card-fields",
        "direct-inputs",
        "varies"
      ]
    },
    "deadEndType": {
      "enum": [
        "turnstile",
        "captcha",
        "paypal-only",
        "login-wall",
        "3ds",
        "stripe-config",
        "automation-blocked"
      ]
    },
    "selectorList": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      ]
    },
    "base": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "status": { "$ref": "#/definitions/status" },
        "lastVerifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "evidence": { "type": "string", "minLength": 1 },
        "gotchas": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "status"]
    },
    "steps": {
      "type": "object",
      "properties": {
        "addToCart": { "type": "string", "minLength": 1 },
        "contact": { "type": "string", "minLength": 1 },
        "billing": { "type": "string", "minLength": 1 },
        "payment": { "type": "string", "minLength": 1 },
        "placeOrder": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 }
      },
      "required": ["payment", "placeOrder", "outcome"]
    },
    "platform": {
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "platform" },
            "name": { "type": "string", "minLength": 1 },
            "detect": {
              "type": "object",
              "properties": {
                "hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "urlPatterns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "selectors": { "type": "array", "items": { "type": "string", "minLength": 1 } }
              }
            },
            "cardSurface": { "$ref": "#/definitions/cardSurface" },
            "cvvTarget": { "type": "string", "minLength": 1 },
            "steps": { "$ref": "#/definitions/steps" },
            "selectors": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/selectorList" }
            }
          },
          "required": ["kind", "name", "detect", "cardSurface", "cvvTarget", "steps"]
        }
      ]
    },
    "merchant": {
      "allOf": [
        { "$ref": "#/definitions/base" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "merchant" },
            "hosts": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            },
            "platform": { "type": "string", "minLength": 1 },
            "cardSurface": { "$ref": "#/definitions/cardSurface" },
            "cvvTarget": { "type": "string", "minLength": 1 },
            "overrides": {
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "deadEnd": {
              "type": "object",
              "properties": {
                "type": { "$ref": "#/definitions/deadEndType" },
                "details": { "type": "string", "minLength": 1 }
              },
              "required": ["type"]
            },
            "exampleProductUrl": { "type": "string", "pattern": "^https?://" }
          },
          "required": ["kind", "hosts", "platform"]
        }
      ]
    }
  }
}
