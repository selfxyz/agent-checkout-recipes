{
  "$schema": "../../schema/recipe.schema.json",
  "id": "wix",
  "kind": "platform",
  "name": "Wix Stores",
  "status": "unverified",
  "cardSurface": "stripe-payment-element",
  "cvvTarget": "payment-frame:input[name=cvc]",
  "detect": {
    "selectors": [
      "script[src*=\"static.parastorage.com\"]",
      "[data-hook=\"ecom-checkout\"]",
      "#SITE_CONTAINER[ng-app]"
    ]
  },
  "notes": "Derived from Wix's checkout structure — validate on first use.",
  "selectors": {
    "addToCart": "[data-hook=\"add-to-cart-button\"]"
  },
  "steps": {
    "addToCart": "[data-hook=add-to-cart-button] → cart → 'Checkout'.",
    "billing": "Wizard — email, then delivery address, then payment.",
    "outcome": "'Thank you' / order number.",
    "payment": "Stripe/Wix Payments Payment Element. Card-number token, then the CVV token immediately after.",
    "placeOrder": "'Place Order' / 'Pay now', once."
  }
}
